.usd-checkout-disclaimer {
    color: var(--color-text-secondary);
    text-align: center;
    margin-inline:0;margin-top: .625rem;
    margin-bottom: 0;
    display: block;
    font-size: 13px!important;
    line-height: 1.3!important
}

.google-translate-host {
    clip: rect(0 0 0 0)!important;
    pointer-events: none!important;
    width: 1px!important;
    height: 1px!important;
    position: absolute!important;
    overflow: hidden!important
}

.goog-te-banner-frame,.goog-te-balloon-frame,iframe.skiptranslate,.goog-logo-link,.goog-te-gadget,#goog-gt-tt,.goog-te-spinner-pos {
    visibility: hidden!important;
    height: 0!important;
    display: none!important
}

body {
    top: 0!important
}

font {
    background: inherit!important;
    box-shadow: none!important;
    color: inherit!important
}

.filter-date-range-popover .rdrCalendarWrapper {
    width: auto!important
}

.filter-date-range-popover .rdrMonth {
    width: 28em
}

.checkerboard-bg {
    background-color: #fff;
    background-image: linear-gradient(45deg,#e2e8f0 25%,#0000 25%),linear-gradient(-45deg,#e2e8f0 25%,#0000 25%),linear-gradient(45deg,#0000 75%,#e2e8f0 75%),linear-gradient(-45deg,#0000 75%,#e2e8f0 75%);
    background-position: 0 0,0 8px,8px -8px,-8px 0;
    background-size: 16px 16px
}

.dark .checkerboard-bg {
    background-color: #303234;
    background-image: linear-gradient(45deg,#222325 25%,#0000 25%),linear-gradient(-45deg,#222325 25%,#0000 25%),linear-gradient(45deg,#0000 75%,#222325 75%),linear-gradient(-45deg,#0000 75%,#222325 75%)
}

.google-pay-button-host img {
    max-width: none
}

